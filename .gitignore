# Data archives: too large for git. data/SHA256SUMS lists them; data/README.md says where to get them.
/data/traces/*.tar.xz
/data/baseline_inputs/*.tar.xz
/data/trace-server/*.tar.gz

# Unpacked by data/unpack.sh
/bench/runs/*/trace/
/bench/baselines/slices/
/bench/baselines/tmll/evidence/
/bench/baselines/tmll/server/
/bench/baselines/tmll/server-workspace/
/trace-server/

# Upstream TMLL for the TMLL baseline (cloned by the user, see bench/baselines/README.md)
/third_party/

# Run-time files
/bench/baselines/codex/work/
/tmll/.tmll_cache/
*.log
!/bench/results/**/*.log
!/bench/runs/*/program.log

# Built bench programs (make)
/bench/batch_server
/bench/ticker
/bench/crunch
/bench/filestore
/bench/pipeline
/bench/kvstore
/bench/cachesvc
/bench/jobrunner
/bench/reporter

# Builds
/traceassist/plugin/bin/
/traceassist/plugin/server/build/
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.log
/paper/*.out
/paper/main.pdf
/paper/figures/*.aux
/paper/figures/*.log

# Python and editors
__pycache__/
.venv/
venv/
*.egg-info/
.DS_Store
/paper/comment.cut
