{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moment",
    "views",
    "reasoning"
  ],
  "properties": {
    "moment": {
      "type": "string",
      "description": "The id of one of the input moments."
    },
    "views": {
      "type": "array",
      "description": "1 to 3 views, the most useful first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "view",
          "tid",
          "cpu",
          "tids",
          "series",
          "look_at"
        ],
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "control_flow",
              "resources",
              "cpu_usage",
              "critical_path",
              "statistics",
              "histogram",
              "event_density",
              "syscall_latency_scatter",
              "syscall_latency_table",
              "sched_latency_scatter",
              "sched_latency_table",
              "disk_io",
              "kernel_memory"
            ]
          },
          "tid": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Focus kind thread: the TID to select (Control Flow) or follow (Critical Path)."
          },
          "cpu": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Focus kind cpu: the CPU to select."
          },
          "tids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Focus kind plot_threads: the TIDs to plot."
          },
          "series": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Focus kind series: the series names to tick."
          },
          "look_at": {
            "type": "string",
            "description": "One or two sentences: what to look for in this view at this moment."
          }
        }
      }
    },
    "reasoning": {
      "type": "string"
    }
  }
}
