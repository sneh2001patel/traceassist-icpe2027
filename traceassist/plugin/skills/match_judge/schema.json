{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts", "reasoning"],
  "properties": {
    "verdicts": {
      "type": "array",
      "description": "One verdict per suspect in the input, in any order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suspect", "verdict", "reason"],
        "properties": {
          "suspect": { "type": "string", "description": "The suspect's id exactly as given, e.g. 'TID 1234'." },
          "verdict": { "type": "string", "enum": ["match", "weak", "no"] },
          "reason": { "type": "string", "description": "One sentence citing the numbers the verdict rests on." }
        }
      }
    },
    "reasoning": { "type": "string", "description": "One or two sentences overall." }
  }
}
