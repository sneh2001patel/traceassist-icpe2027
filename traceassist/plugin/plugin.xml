<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.ui.views">
      <category
            name="TraceAssist"
            id="org.eclipse.tracecompass.helloworld.ui">
      </category>
      <view
            id="org.eclipse.tracecompass.helloworld.ui.views.HelloWorldView"
            name="TraceAssist"
            icon="icons/sample.png"
            class="org.eclipse.tracecompass.helloworld.ui.views.HelloWorldView"
            category="org.eclipse.tracecompass.helloworld.ui"
            inject="true">
      </view>
      <view
            id="org.eclipse.tracecompass.helloworld.ui.views.HelloWorldRagView"
            name="TraceAssist RAG"
            icon="icons/sample.png"
            class="org.eclipse.tracecompass.helloworld.ui.views.HelloWorldRagView"
            category="org.eclipse.tracecompass.helloworld.ui"
            inject="true">
      </view>
	   </extension>
   <extension
         point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension
            targetID="org.eclipse.jdt.ui.JavaPerspective">
         <view
               id="org.eclipse.tracecompass.helloworld.ui.views.HelloWorldView"
               relative="org.eclipse.ui.views.ProblemView"
               relationship="right"
               ratio="0.5">
         </view>
         <view
               id="org.eclipse.tracecompass.helloworld.ui.views.HelloWorldRagView"
               relative="org.eclipse.tracecompass.helloworld.ui.views.HelloWorldView"
               relationship="stack"
               ratio="0.5">
         </view>
	      </perspectiveExtension>
   </extension>
   <extension
         point="org.eclipse.help.contexts">
      <contexts
            file="contexts.xml">
      </contexts>
   </extension>

</plugin>
